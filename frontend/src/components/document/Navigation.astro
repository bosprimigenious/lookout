---
import {safeHref, type Navigation} from '../../lib/document';
import SelectionButton from './SelectionButton.astro';
interface Props {navigation: Navigation}
const {navigation} = Astro.props;
const Tag = navigation.selection ? 'div' : 'nav';
---
<Tag class:list={['document-nav', {'selection-nav': navigation.selection}]}
  role={navigation.selection ? 'group' : undefined} aria-label={navigation.label}>
  {navigation.choices.map(choice => {
    if (navigation.selection) return <SelectionButton choice={choice} group={navigation.label}/>;
    const href = safeHref(choice.href);
    const appearance = choice.appearance ? encodeURIComponent(choice.appearance) : undefined;
    return <a href={href} aria-disabled={!href || undefined} aria-current={choice.selected ? 'page' : undefined}
      data-appearance={appearance}><span class="choice-label">{choice.label}</span>{choice.count != null && <b>{choice.count}</b>}</a>;
  })}
</Tag>
